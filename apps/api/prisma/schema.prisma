generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SELLER
  BIDDER
}

enum WalletEntryType {
  DEPOSIT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  publicId     String   @unique
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  wallet       Wallet?
  auctions     Auction[]
  bids         Bid[]
}

model Wallet {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @unique @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SQL CHECK in the init migration: 0 <= balanceCents <= 2000000000 (MONEY_MAX_CENTS).
  balanceCents Int            @default(0)
  entries      WalletLedger[]
}

model WalletLedger {
  id                String     @id @db.Uuid
  walletId          String     @db.Uuid
  wallet            Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type              WalletEntryType
  /// SQL CHECK: 1 <= amountCents <= 2000000000. Direction lives in `type`, never in the sign.
  amountCents       Int
  /// SQL CHECK: 0 <= balanceAfterCents <= 2000000000.
  balanceAfterCents Int
  auctionId         String?    @db.Uuid
  auction           Auction?   @relation(fields: [auctionId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
}

enum AuctionStatus {
  OPEN
  CANCELLED
}

model Auction {
  id                    String         @id @db.Uuid
  sellerId              String         @db.Uuid
  seller                User           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerPublicId        String
  status                AuctionStatus
  /// SQL CHECKs: 1 <= startingBidCents, minIncrementCents <= 2000000000.
  startingBidCents      Int
  minIncrementCents     Int
  /// SQL CHECK: null, or 1 <= currentBidCents <= 2000000000.
  currentBidCents       Int?
  currentLeaderId       String?        @db.Uuid
  currentLeaderPublicId String?
  /// SQL CHECK: bidCount = 0 only with a null bid and a null leader; a positive count keeps both.
  bidCount              Int            @default(0)
  version               Int            @default(0)
  startsAt              DateTime       @db.Timestamptz(3)
  originalEndsAt        DateTime       @db.Timestamptz(3)
  endsAt                DateTime       @db.Timestamptz(3)
  editionId             String
  workId                String
  title                 String
  authors               String[]       @default([])
  publisher             String?
  publishedDate         String?
  publishedYear         Int?
  isbn                  String?
  language              String?
  description           String?        @db.VarChar(4000)
  coverImage            Bytes?
  coverContentType      String?
  auditHeadHash         String
  auditStateMac         String
  auditKeyVersion       Int
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  bids                  Bid[]
  ledgerEntries         WalletLedger[]

  @@index([status, endsAt])
  @@index([sellerId])
  @@index([currentLeaderId, status])
}

model Bid {
  id             String   @id @db.Uuid
  auctionId      String   @db.Uuid
  auction        Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  sequence       Int
  bidderId       String   @db.Uuid
  bidder         User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  bidderPublicId String
  amountCents    Int
  previousHash   String
  hash           String
  endsAtAfter    DateTime @db.Timestamptz(3)
  /// Written from the authoritative clock of the bid transaction. No database default.
  createdAt      DateTime @db.Timestamptz(3)

  @@unique([auctionId, sequence])
}
